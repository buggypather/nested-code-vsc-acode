{
  "name": "nested-code-vscode",
  "displayName": "Nested Code",
  "description": "Syntax highlighting for nested and embedded languages.",
  "version": "0.2.0",
  "publisher": "buggypather",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buggypather/nested-code-vsc-acode.git"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:json", "onLanguage:jsonc", "onLanguage:javascript",
    "onLanguage:typescript", "onLanguage:javascriptreact", "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.bundle.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild dist/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.bundle.js",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": { "@nested-code/core": "0.1.0" },
  "devDependencies": { "@types/vscode": "^1.90.0", "typescript": "^5.9.0" },
  "contributes": {
    "semanticTokenTypes": [
      {"id":"nestedTag","superType":"type","description":"HTML/XML tag inside another language."},
      {"id":"nestedAttribute","superType":"property","description":"HTML/XML attribute inside another language."},
      {"id":"nestedAttributeValue","superType":"string","description":"HTML/XML attribute value inside another language."},
      {"id":"nestedComment","superType":"comment","description":"Comment in nested markup."},
      {"id":"nestedCdata","superType":"string","description":"CDATA, doctype, or processing instruction in nested markup."},
      {"id":"nestedInvalid","superType":"string","description":"Malformed nested markup recovered by the parser."},
      {"id":"punctuation","superType":"operator","description":"Punctuation in structured nested code."},
      {"id":"invalid","superType":"string","description":"Invalid structured nested code."}
    ]
  }
}
